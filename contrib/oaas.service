[Unit]
Description=OAAS — orchestrateur LLM local (proxy OpenAI-compatible)
After=network.target

[Service]
Type=simple
Environment=RUST_LOG=info
# Adapte les chemins :
# Binaire : ~/.local/bin/oaas (make install-user) ou cargo install --path .
ExecStart=%h/.local/bin/oaas serve --config %h/.config/oaas/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
